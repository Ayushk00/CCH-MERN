PORT=3000
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string WITHOUT a database name (the app uses the "CCH" database)
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Any long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d
PASSWORD_RESET_TOKEN_SECRET=change-me-as-well
PASSWORD_RESET_TOKEN_EXPIRY=15m

# Admin account (created on first server start; there is no admin sign-up)
ADMIN_NAME=Placement Admin
ADMIN_EMAIL=admin@campuscareerhub.com
ADMIN_PASSWORD=Admin123

# Email. Leave SMTP_HOST empty to use a free Ethereal test inbox (preview links, no real delivery).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus CareerHub" <no-reply@campuscareerhub.com>
TIMEZONE=Asia/Kolkata
